<h2><%= @room.other_user(current_user)&.name || "Member" %>さんへDM</h2>

<div id="messages" style="max-height:500px; overflow-y:auto; padding:10px; display:flex; flex-direction:column; gap:10px;">
  <% @messages.each do |m| %>
    <div style="display:flex; flex-direction:column; align-items:<%= m.user == current_user ? 'flex-end' : 'flex-start' %>;">
      <div style="background-color:<%= m.user == current_user ? '#dcf8c6' : '#f1f0f0' %>; padding:10px; border-radius:10px; max-width:60%;">
        <p><%= simple_format(h(m.content)) %></p>
        <small><%= l(m.created_at, format: :short) %></small>
      </div>
    </div>
  <% end %>
</div>

<%= form_with model: [@room, @message], local: false, data: { turbo: true }, id: "new_message" do |f| %>
  <%= f.text_area :content, rows: 3, placeholder: "メッセージを入力..." %>
  <%= f.submit "送信" %>
<% end %>

<script>
document.addEventListener("turbo:load", function() {
  var el = document.getElementById('messages');
  if (el) el.scrollTop = el.scrollHeight;
});
</script>

