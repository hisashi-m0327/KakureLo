<h2 class="mb-3"><%= @room.other_user(current_user)&.name || "Member" %> さんとのDM</h2>

<div id="messages" 
     style="max-height:60vh; overflow-y:auto; padding:15px; background:#fafafa; border-radius:8px;
            display:flex; flex-direction:column; gap:12px;">

  <% prev_date = nil %>

  <% @messages.each do |m| %>

    <% current_date = m.created_at.to_date %>

    <% if prev_date != current_date %>
      <div class="messages-post-date" style="text-align:center; margin:15px 0; color:#666; font-size:14px;">
        ── <%= current_date.strftime('%Y/%m/%d') %> ──
      </div>
      <% prev_date = current_date %>
    <% end %>

    <%= render 'public/messages/message', m: m %>
  <% end %>

</div>

<div style="margin-top:15px;">
  <%= form_with model: [@room, @message], local: false do |f| %>
    <%= f.text_area :content, rows: 3, placeholder: "メッセージを入力...", required: true,
          style:"width:100%; padding:10px; border-radius:10px; margin-bottom:8px;" %>
    <%= f.submit "送信", class:"btn btn-primary w-100" %>
  <% end %>
</div>

<script>
  const messageScrollBottom = () => {
    const el = document.getElementById('messages');
    const bottom = el.scrollHeight - el.clientHeight
    el.scroll(0, bottom)
  }
  messageScrollBottom();
</script>


