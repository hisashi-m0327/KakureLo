<h1 class="mb-4">DM一覧</h1>

<div class="list-group">

  <% @rooms.each do |room| %>
    <% other = room.other_user(current_user) %>
    <% last_message = room.messages.last %>

    <%= link_to room_path(room), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>

      <div>
        <div class="fw-bold">
          <%= other ? other.name : "Unknown" %>
        </div>

        <% if last_message %>
          <div class="text-muted small">
            <%= truncate(last_message.content, length: 40) %>
          </div>
        <% else %>
          <div class="text-muted small">メッセージはまだありません</div>
        <% end %>
      </div>

      <% if last_message %>
        <div class="text-muted small ms-3">
          <%= time_ago_in_words(last_message.created_at) %>前
        </div>
      <% end %>

    <% end %>

  <% end %>

</div>

