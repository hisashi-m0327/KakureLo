<div class="card-list-container py-5">

  <div class="card-list-container py-5">

  <% if user_signed_in? %>
    <div class="container mb-4">
      <%= form_with url: search_path, method: :get, local: true, class: "d-flex gap-2" do %>

        <%= text_field_tag :query, params[:query], class: "form-control", placeholder: "検索ワード" %>

        <%= select_tag :target,
              options_for_select([["投稿を検索", "post"], ["ユーザーを検索", "user"]]),
              class: "form-select" %>

        <%= submit_tag "検索", class: "btn btn-primary" %>

      <% end %>
    </div>

    <div class="container mb-4 text-end">
      <%= link_to "地図で見る", map_path, class: "btn btn-outline-success" %>
    </div>
  <% end %>


  <% @posts.each do |post| %>
    <div class="card w-75 mx-auto mt-4 shadow-lg">
      <%= link_to post_path(post.id) do %>
        <%= image_tag post.get_image, class: "card-img-top"; %>
      <% end %>
      <div class="card-body">
        <div class="row">
          <div class="col-2">
            <%= image_tag post.user.get_profile_image(80,80), class: "mt-3 rounded-circle img-fluid", style: "width: 80px; height: 80px; object-fit: cover;" %>

          </div>
          <div class="col-10">
            <p class="card-title">
              <%= link_to(post_path(post.id), class: "text-dark") do %>
                <strong><span>【<%= post.title %>】</span></strong>
              <% end %>
            </p>
            <p class="card-text"><i class="fa-solid fa-square-pen"></i><%= post.body %>
            </p>
              <span>
                <i class="fas fa-user"></i>
                <%= link_to post.user.name, user_path(post.user), class: "text-decoration-none text-dark" %>
              </span>
            <p><%= link_to "#{post.post_comments.count} コメント", post_path(post.id) %></p>
          </div>
        </div>
      </div>
    </div>
  <% end %>

</div>

