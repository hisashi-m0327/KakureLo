<h1 class="text-center mb-4">新規投稿</h1>

<div class="card w-75 mx-auto shadow-lg">
  <div class="card-body">

    <%= form_with model: @post, local: true, html: { multipart: true } do |f| %>
      
      <%= render 'layouts/error_messages', model: f.object %>

      <div class="mb-3">
        <%= f.label :image, "画像", class: "form-label" %>
        <%= f.file_field :image, accept: "image/*", class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :title, "タイトル", class: "form-label" %>
        <%= f.text_field :title, class: "form-control", placeholder: "タイトルを入力" %>
      </div>
      
      <div class="mb-3">
        <%= f.label :body, "本文", class: "form-label" %>
        <%= f.text_area :body, class: "form-control", rows: 5, placeholder: "本文を入力" %>
      </div>

      <div class="text-center">
        <%= f.submit "投稿する", class: "btn btn-primary btn-lg" %>
      </div>

    <% end %>
  </div>
</div>


