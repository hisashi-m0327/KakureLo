<h1 class="text-center mb-4">投稿の編集</h1>

<div class="card w-75 mx-auto shadow-lg">
  <div class="card-body">

    <%= form_with model: @post, url: post_path(@post), method: :patch, local: true, html: { multipart: true } do |f| %>

      <%= render 'layouts/error_messages', model: f.object %>

      <% if @post.image.attached? %>
        <div class="mb-3 text-center">
          <p>現在の画像</p>
          <%= image_tag @post.image, class: "img-fluid rounded shadow-sm", style: "max-height: 250px;" %>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :image, "画像の変更", class: "form-label" %>
        <%= f.file_field :image, accept: "image/*", class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :title, "タイトル", class: "form-label" %>
        <%= f.text_field :title, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :body, "本文", class: "form-label" %>
        <%= f.text_area :body, class: "form-control", rows: 5 %>
      </div>

      <div class="input-group mb-3 mt-4">
        <div class="input-group-prepend">
          <span class="input-group-text" aria-hidden="true"><i class="fa-solid fa-tenge-sign"></i></span>
        </div>
        <%= text_field_tag :zipcode, nil, class: "form-control", placeholder: "郵便番号" %>
      </div>
      <div class="input-group mb-3 mt-4">
        <div class="input-group-prepend">
          <span class="input-group-text" aria-hidden="true"><i class="fa-solid fa-location-dot"></i></span>
        </div>
        <%= f.text_field :address, class: "form-control", placeholder: "住所" %>
      </div>

      <div class="text-center">
        <%= f.submit "更新する", class: "btn btn-success btn-lg" %>
        <%= link_to "戻る", post_path(@post), class: "btn btn-secondary btn-lg ms-3" %>
      </div>

    <% end %>

    <%= javascript_pack_tag "jpostal",  'data-turbolinks-track': 'reload' %>

  </div>
</div>
