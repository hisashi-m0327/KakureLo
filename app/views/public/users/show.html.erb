<div class="container py-5">
  <div class="row">
    
    <div class="col-md-3 mb-4">
      <h2>マイページ</h2>
      <h3><%= @user.name %></h3>

      <% if @user.suspended? %>
        <span class="badge bg-danger">アカウント停止中</span>
      <% end %>

      <% if @user == current_user && !@user.guest_user? %>
        <p class="mt-3">
          <%= link_to "プロフィール編集", edit_user_path(@user), class: "btn btn-dark w-100" %>
        </p>
      <% end %>

      <div class="text-end mt-4 me-4">
        <% if current_user.id != @user.id %>
          <% if @user.is_followed_by?(current_user) %>
            <%= link_to "フォロー解除", user_relationships_path(@user), method: :delete, class: "btn btn-dark w-100" %>
          <% else %>
            <%= link_to "フォローする", user_relationships_path(@user), method: :post, class: "btn btn-outline-secondary w-100" %>
          <% end %>
        <% end %>
      </div>

      <div class="mt-4">

      <div class="mt-4">
        <%= link_to user_relationships_path(@user, type: "followers"), class: "btn btn-outline-secondary w-100 py-3 mb-2" do %>
          <div>
            <div><strong>フォロー:</strong> <%= @user.followings.count %></div>
            <div><strong>フォロワー:</strong> <%= @user.followers.count %></div>
          </div>
       <% end %>
      </div>

      <% if current_user == @user %>
        <%= link_to "DM一覧を見る", rooms_path, class: "btn btn-primary w-100 mb-2" %>
      <% else %>
        <%= button_to "DMを送る", rooms_path(user_id: @user.id), method: :post, class: "btn btn-primary w-100", data: { turbolinks: false } %>
      <% end %>

    </div>

  </div>

    
    <div class="col-md-9">
      <div class="card-list-container py-4">
        <% @posts.each do |post| %>
          
          <div class="card w-100 mx-auto mt-4 shadow-lg">

            <%= link_to post_path(post.id) do %>
              <%= image_tag post.get_image, class: "card-img-top" %>
            <% end %>

            <div class="card-body">
              <div class="row">

                <div class="col-2">
                  <%= image_tag post.user.get_profile_image(80,80), class: "mt-3 rounded-circle img-fluid", style: "width: 80px; height: 80px; object-fit: cover;" %>
                </div>

                <div class="col-10">
                  <p class="card-title">
                    <%= link_to(post_path(post.id), class: "text-dark") do %>
                      <strong>【<%= post.title %>】</strong>
                    <% end %>
                  </p>

                  <p class="card-text">
                    <i class="fa-solid fa-square-pen"></i><%= post.body %>
                  </p>

                  <span class="text-muted">
                    <i class="fas fa-user"></i> By <%= post.user.name %>
                  </span>

                  <p>
                    <%= link_to "#{post.post_comments.count} コメント", post_path(post.id) %>
                  </p>
                </div>

              </div>
            </div>

          </div>

        <% end %>
      </div>
    </div>

  </div>
</div>

