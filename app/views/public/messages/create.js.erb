el = document.getElementById('messages');
messagesPostDate = document.querySelectorAll('.messages-post-date')
dates = [...messagesPostDate].map(o => o.textContent.trim());
currentDate = `── <%=j @message.created_at.strftime('%Y/%m/%d') %> ──`

if (!dates.includes(currentDate)) {
  $('#messages').append(`
    <div style="text-align:center; margin:15px 0; color:#666; font-size:14px;">
      ${currentDate}
    </div>
  `)
}
$('#messages').append(`
  <%=j render 'public/messages/message', m: @message %>
`)
$('#message_content').val("");
bottom = el.scrollHeight - el.clientHeight
el.scroll(0, bottom)

  