<!DOCTYPE html>
<html>
  <head>
    <title>Kakurelo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://kit.fontawesome.com/9b4d8bb1ea.js" crossorigin="anonymous"></script>

    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header>
      <nav class="navbar navbar-expand-lg bg-success">
        <div class="container">
         <%= link_to root_path, class: "navbar-brand ms-4" do %>
          <%= image_tag "logo.png", alt: "KakureLo", class: "navbar-logo" %>
         <% end %>

         <ul class="navbar-nav">
          <% if user_signed_in? %>
            <li class="nav-item"><span class="nav-link text-white">Home</span></li>
            <li class="nav-item"><span class="nav-link text-white">Logout</span></li>
          <% else %>
            <li class="nav-item"><span class="nav-link text-white">Login</span></li>
            <li class="nav-item"><span class="nav-link text-white">Sign up</span></li>
          <% end %>
        </ul>

        </div>
      </nav>
    </header>  

    <%= yield %>
  </body>
</html>
