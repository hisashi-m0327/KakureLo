<!DOCTYPE html>
<html>
  <head>
    <title>Admin - KakureLo</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <% if admin_signed_in? %>
      <nav class="navbar navbar-expand-lg navbar-light navbar-custom">
        <div class="container d-flex justify-content-between align-items-center">

          <%= link_to admin_dashboards_path, class: "navbar-brand ms-4" do %>
            <%= image_tag "logo.png", alt: "KakureLo", class: "navbar-logo" %>
          <% end %>

          <div class="d-flex align-items-center">
            <%= link_to "管理者ダッシュボード", admin_dashboards_path, class: "nav-link text-white fw-bold me-3" %>
            <%= link_to "投稿管理", admin_posts_path, class: "nav-link text-white fw-bold me-3" %>
            <%= link_to "ログアウト", destroy_admin_session_path, method: :delete, class: "nav-link text-white fw-bold" %>
          </div>
        </div>
      </nav>
    <% end %>

    <div style="padding: 20px;">
      <% if notice %>
        <p><%= notice %></p>
      <% end %>

      <% if alert %>
        <p><%= alert %></p>
      <% end %>
      
      <%= yield %>
    </div>

  </body>
</html>

