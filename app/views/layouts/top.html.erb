<!DOCTYPE html>
<html>
  <head>
    <title>Kakurelo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://kit.fontawesome.com/9b4d8bb1ea.js" crossorigin="anonymous"></script>

    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body class="top-page">
    <div class="top-container d-flex flex-column justify-content-center align-items-center">

      <%= link_to about_path do %>
        <%= image_tag "logo.png", alt: "KakureLo", class: "top-logo mb-4" %>
      <% end %>

      <div class="button-row">
        <%= link_to '新規登録', new_user_registration_path, class: 'btn btn-warm btn-lg' %>
        <%= link_to 'ログイン', new_user_session_path, class: 'btn btn-success btn-lg' %>
        <%= button_to 'ゲストログイン(閲覧用)', users_guest_sign_in_path, method: :post, class: 'btn btn-secondary btn-lg' %>

      </div>

    </div>
    <%= yield %>
  </body>
</html>