<!DOCTYPE html>
<html>
  <head>
    <title>Kakurelo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://kit.fontawesome.com/9b4d8bb1ea.js" crossorigin="anonymous"></script>

    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body class="top-page">
    <div class="mx-auto text-center mt-5" style="max-width: 600px;">

    <%= image_tag "kakurelo.png", alt: "KakureLo", class: "top-logo mb-4" %>

      <div class="d-grid gap-3">
        <%= link_to 'Log in', new_user_session_path, class: 'btn btn-info btn-lg' %>
        <%= link_to 'Sign up', new_user_registration_path, class: 'btn btn-success btn-lg' %>
        <%= link_to 'Guest Log in', new_user_session_path, class: 'btn btn-secondary btn-lg' %>
      </div>

    </div>
    <%= yield %>
  </body>
</html>