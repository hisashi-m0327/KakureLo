<div class="container py-5">
  <h2>マイページ</h2>
  <h3><%= @user.name %></h3>

  <% if @user == current_user && !@user.guest_user? %>
    <p>
      <%= link_to "プロフィール編集", edit_user_path(@user), class: "btn btn-outline-secondary" %>
    </p>
    <p>
      <%= link_to "退会する", user_path(@user), 
          method: :delete,
          data: { confirm: "本当に退会しますか？\n（投稿内容・アカウント情報は削除されます）" },
          class: "btn btn-danger" %>
    </p>
  <% end %>

  <div class="card-list-container py-4">
    <% @posts.each do |post| %>
      <div class="card w-75 mx-auto mt-4 shadow-lg">

        <%= link_to post_path(post.id) do %>
          <%= image_tag post.get_image, class: "card-img-top", style: "height: 300px; object-fit: cover;" %>
        <% end %>

        <div class="card-body">
          <div class="row">

            <div class="col-2">
              <%= image_tag post.user.get_profile_image(80,80), class: "mt-3 rounded-circle img-fluid", style: "width: 80px; height: 80px; object-fit: cover;" %>
            </div>

            <div class="col-10">
              <p class="card-title">
                <%= link_to(post_path(post.id), class: "text-dark") do %>
                  <strong>【<%= post.title %>】</strong>
                <% end %>
              </p>

              <p class="card-text"><i class="fa-solid fa-square-pen"></i><%= post.body %></p>

              <span class="text-muted"><i class="fas fa-user"></i> By <%= post.user.name %></span>
            </div>
          </div>
        </div>

      </div>
    <% end %>
  </div>
</div>
