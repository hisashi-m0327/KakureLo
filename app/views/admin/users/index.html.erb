<h1 class="mb-4">全ユーザー一覧</h1>

<%= form_with url: admin_root_path, method: :get, local: true, class: "mb-3" do |f| %>
  <div class="input-group">
    <%= f.text_field :query, value: params[:query], placeholder: "ユーザー名またはメールで検索", class: "form-control" %>
    <button type="submit" class="btn btn-primary">検索</button>
  </div>
<% end %>

<p class="mb-3">
  <strong>登録ユーザー数：</strong>
  <%= @user_count %>人
</p>

<table class="table table-hover align-middle">
  <thead class="table-dark">
    <tr>
      <th>ID</th>
      <th>名前</th>
      <th>メールアドレス</th>
      <th>投稿数</th>
      <th>登録日</th>
      <th>操作</th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= link_to user.name, admin_user_path(user) %></td>
        <td><%= user.email %></td>
        <td><%= user.posts.count %></td>
        <td><%= l(user.created_at, format: :short) %></td>

        <% button_text = user.suspended? ? "解除" : "アカウント停止" %>
        <% button_class = user.suspended? ? "btn btn-sm btn-success" : "btn btn-sm btn-warning" %>
        <td>
          <%= link_to button_text, admin_user_path(user.id),
            method: :patch,
            data: { confirm: "本当に変更しますか？" },
            class: button_class %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

