<div class="admin-login-container" style="max-width: 400px; margin: 80px auto; padding: 40px; border-radius: 10px; background: #f8f9fa; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
  <h2 style="text-align: center; margin-bottom: 30px;">管理者ログイン</h2>

  <%= form_with model: resource, as: resource_name, url: admin_session_path, local: true do |f| %>
    <div class="field" style="margin-bottom: 15px;">
      <%= f.label :email, "メールアドレス" %><br>
      <%= f.email_field :email, class: "form-control", autofocus: true, autocomplete: "email", style: "width: 100%; padding: 8px; border-radius: 5px; border: 1px solid #ccc;" %>
    </div>

    <div class="field" style="margin-bottom: 15px;">
      <%= f.label :password, "パスワード" %><br>
      <%= f.password_field :password, class: "form-control", autocomplete: "current-password", style: "width: 100%; padding: 8px; border-radius: 5px; border: 1px solid #ccc;" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field" style="margin-bottom: 20px;">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, "ログイン情報を保持する" %>
      </div>
    <% end %>

    <div class="actions" style="text-align: center;">
      <%= f.submit "ログイン", class: "btn btn-primary", style: "padding: 10px 40px; border: none; border-radius: 5px; background-color: #007bff; color: white; cursor: pointer;" %>
    </div>
  <% end %>
</div>