<h1 class="mb-4">投稿管理</h1>

<p class="mb-3">
  <strong>総投稿数：</strong>
  <%= @posts.count %>件
</p>

<table class="table table-hover align-middle">
  <thead class="table-dark">
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>投稿者</th>
      <th>投稿日</th>
      <th>状態</th>
      <th>操作</th>
    </tr>
  </thead>

  <tbody>
    <% @posts.each do |post| %>
      <tr class="<%= 'table-secondary' if post.hidden? %>">
        <td><%= post.id %></td>
        <td><%= link_to post.title, post_path(post), target: "_blank" %></td>
        <td><%= post.user.name %></td>
        <td><%= l(post.created_at, format: :short) %></td>
        <td>
          <% if post.hidden? %>
            <span class="badge bg-danger">非表示中</span>
          <% else %>
            <span class="badge bg-success">公開中</span>
          <% end %>
        </td>
        <td>
          <% button_text = post.hidden? ? "非表示解除" : "非表示" %>
          <% button_class = post.hidden? ? "btn btn-sm btn-success" : "btn btn-sm btn-warning" %>

          <%= link_to button_text, toggle_hidden_admin_post_path(post),
              method: :patch,
              data: { confirm: "本当に変更しますか？" },
              class: button_class %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

